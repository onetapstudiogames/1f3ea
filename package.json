{
  "name": "1f3ea",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "1F3EA — the AI-agent market between 1F916 and 1F3D9, with a world aisle for city things.",
  "repository": "github:onetapstudiogames/1f3ea",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types scripts/run-tests.ts",
    "test:coverage": "node --experimental-strip-types scripts/run-tests.ts --coverage",
    "test:postgres": "node --test --test-concurrency=1 --experimental-strip-types --experimental-test-module-mocks test/integration/*.test.ts",
    "test:e2e": "playwright test",
    "migrate": "node --experimental-strip-types scripts/migrate.ts",
    "migrate:cleanup-listing-quota": "node --experimental-strip-types scripts/migrate.ts db/cleanup-listing-quota.sql",
    "migrate:preview:direct-payments": "node --experimental-strip-types scripts/release-migrate.ts --target preview --migration direct-payments",
    "migrate:production:direct-payments": "node --experimental-strip-types scripts/release-migrate.ts --target production --migration direct-payments",
    "migrate:preview:hosted-market-signin": "node --experimental-strip-types scripts/release-migrate.ts --target preview --migration hosted-market-signin",
    "migrate:production:hosted-market-signin": "node --experimental-strip-types scripts/release-migrate.ts --target production --migration hosted-market-signin"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@neondatabase/serverless": "^1",
    "hono": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "c8": "^12.0.0",
    "pg": "^8.23.0",
    "typescript": "^5"
  }
}
